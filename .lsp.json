{
  "typescript": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescript",
      ".js": "javascript",
      ".jsx": "javascript"
    }
  },
  "vue": {
    "command": "vls",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".vue": "vue"
    }
  }
}
